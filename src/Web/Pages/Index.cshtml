@page
@model Web.Pages.IndexModel
@{
    ViewData["Title"] = "Software Engineer";
    var isRtl = (ViewData["Culture"]?.ToString() ?? "en") == "fa";
    var mainProjects = Model.Projects
        .Where(project => !project.Title.EndsWith(" API", StringComparison.OrdinalIgnoreCase))
        .ToList();
    var groupedExperience = Model.Experience
        .GroupBy(entry => entry.GroupKey)
        .Select(group => new { Company = group.First().Company, Key = group.Key, Entries = group.ToList() })
        .ToList();
}

<section class="mx-auto grid min-h-[680px] w-full max-w-6xl items-center px-5 py-20 sm:px-8 md:grid-cols-[minmax(0,1fr)_220px] md:gap-8 lg:grid-cols-[minmax(0,1fr)_340px] lg:gap-14 lg:py-28">
    <div>
        <p class="text-sm font-medium text-forest dark:text-[#90b89d]">@(isRtl ? "سلام، من" : "Hello, I'm")</p>
        <h1 class="mt-3 text-5xl font-semibold tracking-[-0.045em] sm:text-7xl">@Model.Content.Name</h1>
        <p class="mt-4 text-2xl text-black/65 dark:text-white/65 sm:text-3xl">@Model.Content.Title</p>

        <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm text-black/55 dark:text-white/55">
            <span class="inline-flex items-center gap-2">
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 18s6-5.1 6-10A6 6 0 1 0 4 8c0 4.9 6 10 6 10Z" stroke="currentColor" stroke-width="1.4" /><circle cx="10" cy="8" r="2" stroke="currentColor" stroke-width="1.4" /></svg>
                @(isRtl ? "استانبول، ترکیه" : "Istanbul, Turkey")
            </span>
            <span class="inline-flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-[#4c9b64]"></span>
                @(isRtl ? "آماده همکاری ریموت و جابجایی" : "Remote and open to relocation")
            </span>
        </div>

        <p class="mt-8 max-w-2xl text-base leading-8 text-black/62 dark:text-white/62">@Model.Content.Bio</p>

        <div class="mt-9 flex flex-wrap gap-3">
            <a href="#work" class="inline-flex h-11 items-center rounded-md bg-ink px-5 text-sm font-medium text-white transition hover:bg-forest dark:bg-[#ecece5] dark:text-[#151613] dark:hover:bg-[#90b89d]">
                @(isRtl ? "مشاهده پروژه‌ها" : "View my work")
            </a>
            <a href="~/files/IliyaAhmadiCV.pdf" download class="inline-flex h-11 items-center rounded-md border border-black/15 px-5 text-sm font-medium transition hover:border-black/40 dark:border-white/15 dark:hover:border-white/40">
                @(isRtl ? "دانلود رزومه" : "Download resume")
            </a>
            <a href="#contact" class="inline-flex h-11 items-center px-2 text-sm font-medium text-forest underline decoration-forest/25 underline-offset-4 dark:text-[#90b89d]">
                @(isRtl ? "تماس با من" : "Contact me")
            </a>
        </div>
    </div>

    <figure class="mx-auto hidden w-full max-w-[220px] md:block lg:max-w-[340px]">
        <button type="button" class="portrait-flip aspect-square w-full cursor-pointer rounded-lg outline-none focus-visible:ring-4 focus-visible:ring-forest/20 dark:focus-visible:ring-[#90b89d]/20" aria-label="@(isRtl ? "نمایش تصویر ایلیا احمدی" : "Reveal a portrait of Iliya Ahmadi")">
            <span class="portrait-flip-inner block">
                <span class="portrait-flip-face block overflow-hidden rounded-lg border border-black/10 bg-[#dce7d8] p-2 dark:border-white/10 dark:bg-[#263127]">
                    <img src="~/images/minecraft-chick.webp" alt="" aria-hidden="true" class="pixel-art aspect-square w-full rounded object-cover" />
                </span>
                <span class="portrait-flip-face portrait-flip-back block overflow-hidden rounded-lg border border-black/10 bg-[#e5e3dc] p-2 dark:border-white/10 dark:bg-[#292925]">
                    <img src="~/images/iliya-ahmadi.webp" alt="" aria-hidden="true" class="aspect-square w-full rounded object-cover" />
                </span>
            </span>
        </button>
    </figure>
</section>

<section id="work" class="relative scroll-mt-24 border-t border-black/10 dark:border-white/10">
    <div class="mx-auto w-full max-w-6xl px-5 py-24 sm:px-8 sm:py-28">
        <h2 class="text-4xl font-semibold tracking-tight">@(isRtl ? "پروژه‌های منتخب" : "Selected work")</h2>

        <div class="mt-14 space-y-10">
            @foreach (var project in mainProjects)
            {
                var apiProject = Model.Projects.FirstOrDefault(candidate =>
                    candidate.Title.Equals($"{project.Title} API", StringComparison.OrdinalIgnoreCase));
                var isInDevelopment = project.Status?.Contains("development", StringComparison.OrdinalIgnoreCase) == true || project.Status?.Contains("توسعه") == true;

                <article class="overflow-hidden rounded-xl border border-black/10 bg-white/55 dark:border-white/10 dark:bg-white/[.025]">
                    <div class="grid lg:grid-cols-[1.05fr_.95fr]">
                        <div class="border-b border-black/10 p-4 dark:border-white/10 lg:border-b-0 lg:border-e">
                            @if (!string.IsNullOrWhiteSpace(project.ImageUrl))
                            {
                                <button type="button" class="group relative block aspect-[16/10] h-full w-full overflow-hidden rounded-lg border border-black/10 bg-[#101012] text-start dark:border-white/10" aria-label="@(isRtl ? $"نمایش تصویر پروژه {project.Title}" : $"Reveal screenshot of {project.Title}")">
                                    <img src="@project.ImageUrl" alt="Screenshot of @project.Title" class="h-full w-full scale-[1.025] object-contain object-center blur-[5px] brightness-[.62] transition duration-500 ease-out group-hover:scale-100 group-hover:blur-0 group-hover:brightness-100 group-focus:scale-100 group-focus:blur-0 group-focus:brightness-100" />
                                    <span class="pointer-events-none absolute inset-0 grid place-items-center transition duration-300 group-hover:opacity-0 group-focus:opacity-0">
                                        <span class="rounded-full border border-white/20 bg-black/45 px-4 py-2 text-xs font-medium text-white backdrop-blur-sm">@(isRtl ? "نمایش تصویر" : "View screenshot")</span>
                                    </span>
                                </button>
                            }
                            else
                            {
                                <div class="flex aspect-[16/10] items-end rounded-lg border border-black/10 bg-[#e8eee6] p-8 dark:border-white/10 dark:bg-[#222920]">
                                    <div class="max-w-sm">
                                        <span class="inline-flex rounded-full bg-white/70 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-forest shadow-sm dark:bg-white/10 dark:text-[#a9cdb2]">@(isRtl ? "در حال ساخت" : "Currently building")</span>
                                        <p class="mt-5 text-4xl font-semibold tracking-tight">@project.Title</p>
                                        <p class="mt-3 text-sm leading-6 text-black/50 dark:text-white/50">@(isRtl ? "راهنمای تصمیم‌گیری ساختاریافته برای مسیر مهاجرت." : "Structured decision support for navigating relocation choices.")</p>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="flex flex-col justify-between p-6 sm:p-8">
                            <div>
                                <div class="flex flex-wrap items-center justify-between gap-3">
                                    <h3 class="text-3xl font-semibold tracking-tight">@project.Title</h3>
                                    @if (!string.IsNullOrWhiteSpace(project.Status))
                                    {
                                        <span class="rounded-full border px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.12em] @(isInDevelopment ? "border-amber-500/25 bg-amber-500/5 text-amber-700 dark:text-amber-300" : "border-forest/25 bg-forest/5 text-forest dark:text-[#90b89d]")">@project.Status</span>
                                    }
                                </div>
                                <p class="mt-5 text-sm leading-7 text-black/58 dark:text-white/58">@project.Description</p>
                                <div class="mt-6 flex flex-wrap gap-2">
                                    @foreach (var tech in project.TechStack)
                                    {
                                        <span class="rounded-md border border-black/10 bg-black/[.025] px-2.5 py-1.5 text-xs dark:border-white/10 dark:bg-white/[.035]">@tech</span>
                                    }
                                </div>
                            </div>

                            <div class="mt-8 flex flex-wrap gap-5 text-sm font-medium">
                                @if (!string.IsNullOrWhiteSpace(project.GitHubUrl))
                                {
                                    <a href="@project.GitHubUrl" target="_blank" rel="noreferrer" class="text-forest underline decoration-forest/25 underline-offset-4 dark:text-[#90b89d]">GitHub ↗</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(project.LiveDemoUrl))
                                {
                                    <a href="@project.LiveDemoUrl" target="_blank" rel="noreferrer" class="text-forest underline decoration-forest/25 underline-offset-4 dark:text-[#90b89d]">@(isRtl ? "دموی آنلاین" : "Live demo") ↗</a>
                                }
                            </div>
                        </div>
                    </div>

                    @if (apiProject is not null)
                    {
                        <div class="border-t border-black/10 bg-black/[.018] p-5 dark:border-white/10 dark:bg-black/10 sm:p-6">
                            <div class="grid gap-5 sm:grid-cols-[160px_1fr_auto] sm:items-center">
                                <div>
                                    <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-black/40 dark:text-white/40">@(isRtl ? "سرویس همراه" : "Companion service")</p>
                                    <h4 class="mt-1 font-semibold">@apiProject.Title</h4>
                                </div>
                                <div>
                                    <p class="text-xs leading-5 text-black/50 dark:text-white/50">@apiProject.Description</p>
                                    <div class="mt-3 flex flex-wrap gap-1.5">
                                        @foreach (var tech in apiProject.TechStack)
                                        {
                                            <span class="rounded border border-black/10 px-2 py-1 text-[10px] dark:border-white/10">@tech</span>
                                        }
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(apiProject.GitHubUrl))
                                {
                                    <a href="@apiProject.GitHubUrl" target="_blank" rel="noreferrer" class="text-xs font-medium text-forest dark:text-[#90b89d]">API source ↗</a>
                                }
                            </div>
                        </div>
                    }
                </article>
            }
        </div>
    </div>
</section>

<section id="experience" class="relative scroll-mt-24 border-t border-black/10 dark:border-white/10">
    <div dir="ltr" aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 mx-auto flex w-full max-w-6xl -translate-y-[88%] px-5 sm:px-8 lg:max-w-none lg:px-6 @(isRtl ? "justify-start" : "justify-end")">
        <img src="~/images/chick-dividers/experience.webp" alt="" class="pixel-art h-12 w-12" />
    </div>
    <div class="mx-auto w-full max-w-6xl px-5 py-24 sm:px-8 sm:py-28">
        <div class="flex items-center justify-between gap-6">
            <h2 class="text-4xl font-semibold tracking-tight">@(isRtl ? "سابقه کاری" : "Work history")</h2>
            <a href="~/files/IliyaAhmadiCV.pdf" target="_blank" class="hidden flex-none text-sm font-medium text-forest underline decoration-forest/25 underline-offset-4 sm:block dark:text-[#90b89d]">@(isRtl ? "مشاهده رزومه" : "View resume") ↗</a>
        </div>

        <div class="mt-14 border-t border-black/10 dark:border-white/10">
            @foreach (var group in groupedExperience)
            {
                <article class="grid gap-6 border-b border-black/10 py-10 md:grid-cols-[220px_1fr] md:gap-12 dark:border-white/10">
                    <div>
                        <div class="flex items-center gap-3">
                            @if (!string.IsNullOrWhiteSpace(group.Entries.First().LogoUrl))
                            {
                                <span class="grid h-9 w-9 place-items-center overflow-hidden rounded-md border border-black/10 bg-white p-1.5 dark:border-white/10"><img src="@group.Entries.First().LogoUrl" alt="" class="h-full w-full object-contain" /></span>
                            }
                            <h3 class="whitespace-nowrap font-semibold">@group.Company</h3>
                        </div>
                    </div>

                    <div class="space-y-9">
                        @foreach (var entry in group.Entries)
                        {
                            <div>
                                <div class="flex flex-wrap items-baseline justify-between gap-2">
                                    <div>
                                        <h4 class="font-medium">@(entry.Team ?? entry.Role)</h4>
                                        @if (!string.IsNullOrWhiteSpace(entry.Team))
                                        {
                                            <p class="mt-1 text-xs text-black/40 dark:text-white/40">@entry.Role</p>
                                        }
                                    </div>
                                    <span class="text-xs text-black/38 dark:text-white/38">@entry.DateRange</span>
                                </div>
                                <ul class="mt-4 space-y-2.5 text-sm leading-6 text-black/58 dark:text-white/58">
                                    @foreach (var point in entry.Highlights)
                                    {
                                        <li class="flex gap-3"><span class="mt-[10px] h-1 w-1 flex-none rounded-full bg-forest dark:bg-[#90b89d]"></span><span>@point</span></li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-2">
            <div class="rounded-lg border border-black/10 p-5 dark:border-white/10">
                <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-black/40 dark:text-white/40">@(isRtl ? "تحصیلات" : "Education")</p>
                <p class="mt-3 font-medium">@(isRtl ? "کارشناسی مهندسی کامپیوتر" : "B.Sc. in Computer Engineering")</p>
                <p class="mt-1 text-sm text-black/50 dark:text-white/50">@(isRtl ? "دانشگاه آزاد مشهد، ۱۴۰۱ - ۱۴۰۵" : "Azad University of Mashhad, 2022 - 2026")</p>
            </div>
            <div class="rounded-lg border border-black/10 p-5 dark:border-white/10">
                <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-black/40 dark:text-white/40">@(isRtl ? "زبان‌ها" : "Languages")</p>
                <p class="mt-3 font-medium">@(isRtl ? "انگلیسی - مسلط" : "English - Proficient")</p>
                <p class="mt-1 text-sm text-black/50 dark:text-white/50">@(isRtl ? "آلمانی - B2" : "German - B2")</p>
            </div>
        </div>
    </div>
</section>

<section id="skills" class="relative scroll-mt-24 border-t border-black/10 dark:border-white/10">
    <div dir="ltr" class="pointer-events-none absolute inset-x-0 top-0 mx-auto flex w-full max-w-6xl -translate-y-[88%] px-5 sm:px-8 lg:max-w-none lg:px-6 @(isRtl ? "justify-end" : "justify-start")">
        <div class="pointer-events-auto relative">
            <span id="skills-chick-bubble" role="status" aria-live="polite" class="absolute bottom-full mb-2 hidden whitespace-nowrap border-2 border-ink bg-canvas px-3 py-2 font-mono text-xs font-medium shadow-[3px_3px_0_rgba(28,29,26,.22)] @(isRtl ? "right-0" : "left-0") dark:border-[#ecece5] dark:bg-[#151613] dark:shadow-[3px_3px_0_rgba(236,236,229,.16)]">
                @(isRtl ? "واااازااااپ" : "wazzzuuuppp")
                <span class="absolute -bottom-[7px] h-3 w-3 rotate-45 border-b-2 border-r-2 border-ink bg-canvas @(isRtl ? "right-4" : "left-4") dark:border-[#ecece5] dark:bg-[#151613]"></span>
            </span>
            <button type="button" onclick="toggleSkillsChick(this)" aria-controls="skills-chick-bubble" aria-expanded="false" aria-label="@(isRtl ? "جوجه پیکسلی" : "Pixel chicken")" class="block cursor-default outline-none focus-visible:ring-2 focus-visible:ring-forest/40 dark:focus-visible:ring-[#90b89d]/40">
                <img src="~/images/chick-dividers/skills.webp" alt="" aria-hidden="true" class="pixel-art h-12 w-12" />
            </button>
        </div>
    </div>
    <div class="mx-auto w-full max-w-6xl px-5 py-24 sm:px-8 sm:py-28">
        <h2 class="text-4xl font-semibold tracking-tight">@(isRtl ? "ابزار و تخصص" : "Tools and expertise")</h2>

        <div class="mt-14 space-y-4">
            <div class="rounded-xl border border-black/10 p-6 dark:border-white/10">
                <h3 class="text-sm font-semibold">@(isRtl ? "بک‌اند و فریم‌ورک‌ها" : "Backend and frameworks")</h3>
                <div dir="ltr" class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
                    @foreach (var skill in new[] {
                        (".NET / C#", "/images/skills/dotnet.svg"),
                        ("ASP.NET Core", "/images/skills/dotnet.svg"),
                        ("EF Core", "/images/skills/dotnet.svg"),
                        ("Dapper", "/images/skills/dotnet.svg"),
                        ("Node.js", "/images/skills/nodejs.svg"),
                        ("Express", "/images/skills/express.svg")
                    })
                    {
                        <div class="flex min-h-16 items-center gap-3 rounded-lg border border-black/[.06] bg-black/[.025] px-3 dark:border-white/[.06] dark:bg-white/[.035]">
                            <img src="@skill.Item2" alt="" class="h-5 w-5 flex-none object-contain opacity-90" onerror="this.classList.add('hidden');this.nextElementSibling.classList.remove('hidden');this.nextElementSibling.classList.add('grid')" />
                            <span class="hidden h-5 w-5 flex-none place-items-center rounded bg-forest/10 text-[10px] font-semibold text-forest dark:text-[#90b89d]">@skill.Item1.Substring(0, 1)</span>
                            <span class="text-xs font-medium">@skill.Item1</span>
                        </div>
                    }
                </div>
            </div>

            <div class="rounded-xl border border-black/10 p-6 dark:border-white/10">
                <h3 class="text-sm font-semibold">@(isRtl ? "داده و API" : "Data and APIs")</h3>
                <div dir="ltr" class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
                    @foreach (var skill in new[] {
                        ("PostgreSQL", "/images/skills/postgresql.svg"),
                        ("MongoDB", "/images/skills/mongodb.svg"),
                        ("Redis", "/images/skills/redis.svg"),
                        ("REST APIs", "/images/skills/openapi.svg"),
                        ("Swagger / OpenAPI", "/images/skills/swagger.svg")
                    })
                    {
                        <div class="flex min-h-16 items-center gap-3 rounded-lg border border-black/[.06] bg-black/[.025] px-3 dark:border-white/[.06] dark:bg-white/[.035]">
                            <img src="@skill.Item2" alt="" class="h-5 w-5 flex-none object-contain opacity-90" onerror="this.classList.add('hidden');this.nextElementSibling.classList.remove('hidden');this.nextElementSibling.classList.add('grid')" />
                            <span class="hidden h-5 w-5 flex-none place-items-center rounded bg-forest/10 text-[10px] font-semibold text-forest dark:text-[#90b89d]">@skill.Item1.Substring(0, 1)</span>
                            <span class="text-xs font-medium">@skill.Item1</span>
                        </div>
                    }
                </div>
            </div>

            <div class="rounded-xl border border-black/10 p-6 dark:border-white/10">
                <h3 class="text-sm font-semibold">@(isRtl ? "زیرساخت و تحویل" : "Infrastructure and delivery")</h3>
                <div dir="ltr" class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
                    @foreach (var skill in new[] {
                        ("Docker", "/images/skills/docker.svg"),
                        ("Linux", "/images/skills/linux.svg"),
                        ("Azure", "/images/skills/azure.svg"),
                        ("GitLab CI", "/images/skills/gitlab.svg"),
                        ("RabbitMQ", "/images/skills/rabbitmq.svg"),
                        ("Git", "/images/skills/git.svg"),
                        ("SigNoz", "/images/skills/signoz.webp"),
                        ("Jira / Agile", "/images/skills/jira.svg")
                    })
                    {
                        <div class="flex min-h-16 items-center gap-3 rounded-lg border border-black/[.06] bg-black/[.025] px-3 dark:border-white/[.06] dark:bg-white/[.035]">
                            <img src="@skill.Item2" alt="" class="h-5 w-5 flex-none object-contain opacity-90" onerror="this.classList.add('hidden');this.nextElementSibling.classList.remove('hidden');this.nextElementSibling.classList.add('grid')" />
                            <span class="hidden h-5 w-5 flex-none place-items-center rounded bg-forest/10 text-[10px] font-semibold text-forest dark:text-[#90b89d]">@skill.Item1.Substring(0, 1)</span>
                            <span class="text-xs font-medium">@skill.Item1</span>
                        </div>
                    }
                </div>
            </div>

            <div class="rounded-xl border border-black/10 p-6 dark:border-white/10">
                <h3 class="text-sm font-semibold">@(isRtl ? "تست" : "Testing")</h3>
                <div dir="ltr" class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
                    @foreach (var skill in new[] {
                        ("xUnit", "/images/skills/dotnet.svg"),
                        ("Jest", "/images/skills/jest.svg"),
                        ("Playwright", "/images/skills/playwright.svg"),
                        ("k6", "/images/skills/k6.svg")
                    })
                    {
                        <div class="flex min-h-16 items-center gap-3 rounded-lg border border-black/[.06] bg-black/[.025] px-3 dark:border-white/[.06] dark:bg-white/[.035]">
                            <img src="@skill.Item2" alt="" class="h-5 w-5 flex-none object-contain opacity-90" onerror="this.classList.add('hidden');this.nextElementSibling.classList.remove('hidden');this.nextElementSibling.classList.add('grid')" />
                            <span class="hidden h-5 w-5 flex-none place-items-center rounded bg-forest/10 text-[10px] font-semibold text-forest dark:text-[#90b89d]">@skill.Item1.Substring(0, 1)</span>
                            <span class="text-xs font-medium">@skill.Item1</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section id="contact" class="relative scroll-mt-24 border-t border-black/10 dark:border-white/10">
    <div dir="ltr" aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 mx-auto flex w-full max-w-6xl -translate-y-[88%] px-5 sm:px-8 lg:max-w-none lg:px-6 @(isRtl ? "justify-start" : "justify-end")">
        <img src="~/images/chick-dividers/contact.webp" alt="" class="pixel-art h-12 w-12" />
    </div>
    <div class="mx-auto grid w-full max-w-6xl gap-12 px-5 py-24 sm:px-8 sm:py-28 lg:grid-cols-[.82fr_1.18fr] lg:gap-16">
        <div class="lg:py-5">
            <span class="inline-flex items-center gap-2 rounded-full border border-forest/15 bg-white/45 px-3 py-1.5 text-xs font-medium text-forest dark:border-[#90b89d]/15 dark:bg-white/[.035] dark:text-[#90b89d]">
                <span class="h-2 w-2 rounded-full bg-[#4c9b64]"></span>
                @(isRtl ? "آماده همکاری" : "Open to opportunities")
            </span>
            <h2 class="mt-5 text-4xl font-semibold tracking-tight">@(isRtl ? "بیایید در ارتباط باشیم" : "Let's talk")</h2>
            <p class="mt-5 max-w-md text-sm leading-7 text-black/55 dark:text-white/55">@(isRtl ? "برای فرصت‌های شغلی دورکاری، موقعیت‌های همراه با امکان جابه‌جایی یا همکاری در پروژه‌های بک‌اند، خوشحال می‌شوم مستقیماً با من در ارتباط باشید." : "For remote roles, relocation opportunities, or a backend project, send me a message directly.")</p>
            <div class="mt-9 space-y-2.5">
                <a href="mailto:iliyahmdi.info@gmail.com" class="group flex items-center justify-between gap-4 rounded-lg border border-black/10 bg-white/35 px-4 py-3.5 transition hover:border-forest/30 hover:bg-white/65 dark:border-white/10 dark:bg-white/[.025] dark:hover:border-[#90b89d]/30 dark:hover:bg-white/[.05]">
                    <span class="min-w-0"><span class="block text-[10px] font-semibold uppercase tracking-[0.12em] text-black/35 dark:text-white/35">Email</span><span class="mt-1 block break-all text-sm font-medium">iliyahmdi.info@gmail.com</span></span>
                    <span class="text-forest transition group-hover:translate-x-0.5 dark:text-[#90b89d]">↗</span>
                </a>
                <div class="grid grid-cols-2 gap-2.5">
                    <a href="https://linkedin.com/in/iliyaahmadi" target="_blank" rel="noreferrer" class="group flex items-center justify-between rounded-lg border border-black/10 bg-white/35 px-4 py-3.5 text-sm font-medium transition hover:border-forest/30 hover:bg-white/65 dark:border-white/10 dark:bg-white/[.025] dark:hover:border-[#90b89d]/30 dark:hover:bg-white/[.05]"><span>LinkedIn</span><span class="text-forest transition group-hover:translate-x-0.5 dark:text-[#90b89d]">↗</span></a>
                    <a href="https://github.com/iliyaahmadi" target="_blank" rel="noreferrer" class="group flex items-center justify-between rounded-lg border border-black/10 bg-white/35 px-4 py-3.5 text-sm font-medium transition hover:border-forest/30 hover:bg-white/65 dark:border-white/10 dark:bg-white/[.025] dark:hover:border-[#90b89d]/30 dark:hover:bg-white/[.05]"><span>GitHub</span><span class="text-forest transition group-hover:translate-x-0.5 dark:text-[#90b89d]">↗</span></a>
                </div>
            </div>
        </div>

        <div class="rounded-2xl border border-forest/15 bg-[#dfe6dc]/90 p-6 shadow-[0_28px_70px_-48px_rgba(41,72,49,.7)] dark:border-white/10 dark:bg-[#1c201c] dark:shadow-none sm:p-8">
            @if (Model.MessageSent)
            {
                <div role="status" aria-live="polite" class="grid min-h-[320px] place-items-center rounded-xl border border-forest/10 bg-white/45 p-8 text-center text-sm text-forest dark:border-white/10 dark:bg-black/15 dark:text-[#90b89d]">@(isRtl ? "ممنون - پیام شما ارسال شد. به‌زودی پاسخ می‌دهم." : "Thanks - your message has been sent. I'll get back to you soon.")</div>
            }
            else
            {
                <form method="post" asp-page="/Index" asp-fragment="contact" class="space-y-5" novalidate>
                    @if (Model.MessageFailed)
                    {
                        <div role="alert" class="rounded-lg border border-[#b7793b]/25 bg-[#fff4e7]/80 px-4 py-3 text-sm leading-6 text-[#754515] dark:border-[#e1a865]/20 dark:bg-[#e1a865]/10 dark:text-[#efc28d]">
                            @(isRtl ? "ارسال پیام انجام نشد. لطفاً دوباره تلاش کنید یا مستقیماً ایمیل بزنید." : "The message could not be sent. Please try again or email me directly.")
                        </div>
                    }
                    <div class="grid gap-5 sm:grid-cols-2">
                        <div>
                            <label asp-for="Input.Name" class="mb-2 block text-xs font-medium text-black/65 dark:text-white/65">@(isRtl ? "نام" : "Name")</label>
                            <input asp-for="Input.Name" autocomplete="name" class="h-12 w-full rounded-lg border border-black/10 bg-white/75 px-4 text-sm shadow-sm outline-none transition placeholder:text-black/25 focus:border-forest/50 focus:bg-white focus:ring-4 focus:ring-forest/10 dark:border-white/10 dark:bg-black/20 dark:shadow-none dark:focus:border-[#90b89d]/45 dark:focus:bg-black/30 dark:focus:ring-[#90b89d]/10" />
                            <span asp-validation-for="Input.Name" class="mt-1.5 block text-xs text-red-500"></span>
                        </div>
                        <div>
                            <label asp-for="Input.Email" class="mb-2 block text-xs font-medium text-black/65 dark:text-white/65">@(isRtl ? "ایمیل" : "Email")</label>
                            <input asp-for="Input.Email" autocomplete="email" inputmode="email" class="h-12 w-full rounded-lg border border-black/10 bg-white/75 px-4 text-sm shadow-sm outline-none transition placeholder:text-black/25 focus:border-forest/50 focus:bg-white focus:ring-4 focus:ring-forest/10 dark:border-white/10 dark:bg-black/20 dark:shadow-none dark:focus:border-[#90b89d]/45 dark:focus:bg-black/30 dark:focus:ring-[#90b89d]/10" />
                            <span asp-validation-for="Input.Email" class="mt-1.5 block text-xs text-red-500"></span>
                        </div>
                    </div>
                    <div>
                        <label asp-for="Input.Message" class="mb-2 block text-xs font-medium text-black/65 dark:text-white/65">@(isRtl ? "پیام" : "Message")</label>
                        <textarea asp-for="Input.Message" rows="6" class="w-full resize-none rounded-lg border border-black/10 bg-white/75 p-4 text-sm leading-6 shadow-sm outline-none transition placeholder:text-black/25 focus:border-forest/50 focus:bg-white focus:ring-4 focus:ring-forest/10 dark:border-white/10 dark:bg-black/20 dark:shadow-none dark:focus:border-[#90b89d]/45 dark:focus:bg-black/30 dark:focus:ring-[#90b89d]/10"></textarea>
                        <span asp-validation-for="Input.Message" class="mt-1.5 block text-xs text-red-500"></span>
                    </div>
                    <button type="submit" class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-lg bg-ink px-6 text-sm font-medium text-white transition hover:bg-forest focus:outline-none focus:ring-4 focus:ring-forest/15 sm:w-auto dark:bg-[#e7ebe5] dark:text-[#151613] dark:hover:bg-[#90b89d] dark:focus:ring-[#90b89d]/15"><span>@(isRtl ? "ارسال پیام" : "Send message")</span><span aria-hidden="true">↗</span></button>
                </form>
            }
        </div>
    </div>
</section>
