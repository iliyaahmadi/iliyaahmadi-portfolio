@page
@model Web.Pages.IndexModel
@{
    var culture = ViewData["Culture"]?.ToString() ?? "en";
    var isRtl = culture == "fa";
    var portraitLabel = culture switch
    {
        "de" => "Pixel-Huhn anzeigen",
        "fa" => "نمایش جوجه پیکسلی",
        _ => "Reveal the pixel chick"
    };
    var resumeAction = Model.Content.Hero.Actions.FirstOrDefault(action => action.Key == "resume");
    var mainProjects = Model.Projects
        .Where(project => !project.Title.EndsWith(" API", StringComparison.OrdinalIgnoreCase))
        .ToList();
    var groupedExperience = Model.Experience
        .GroupBy(entry => entry.GroupKey)
        .Select(group => new { Company = group.First().Company, Key = group.Key, Entries = group.ToList() })
        .ToList();
}

<section class="mx-auto grid min-h-[680px] w-full max-w-6xl items-center px-5 py-20 sm:px-8 md:grid-cols-[minmax(0,1fr)_220px] md:gap-8 lg:grid-cols-[minmax(0,1fr)_340px] lg:gap-14 lg:py-28">
    <div>
        <p class="text-sm font-medium text-forest dark:text-[#90b89d]">@Model.Content.Hero.Greeting</p>
        <h1 class="mt-3 text-5xl font-semibold tracking-[-0.045em] sm:text-7xl">@Model.Content.Hero.Name</h1>
        <p class="mt-4 text-2xl text-black/65 dark:text-white/65 sm:text-3xl">@Model.Content.Hero.Title</p>

        <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm text-black/55 dark:text-white/55">
            @foreach (var detail in Model.Content.Hero.Details)
            {
                <span class="inline-flex items-center gap-2">
                    @if (detail.Icon == "location")
                    {
                        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 18s6-5.1 6-10A6 6 0 1 0 4 8c0 4.9 6 10 6 10Z" stroke="currentColor" stroke-width="1.4" /><circle cx="10" cy="8" r="2" stroke="currentColor" stroke-width="1.4" /></svg>
                    }
                    else
                    {
                        <span class="h-2 w-2 rounded-full bg-[#4c9b64]"></span>
                    }
                    @detail.Text
                </span>
            }
        </div>

        <p class="mt-8 max-w-2xl text-base leading-8 text-black/62 dark:text-white/62">@Model.Content.Hero.Bio</p>

        <div class="mt-9 flex flex-wrap gap-3">
            @foreach (var action in Model.Content.Hero.Actions)
            {
                var actionClass = action.Style switch
                {
                    "primary" => "inline-flex h-11 items-center rounded-md bg-ink px-5 text-sm font-medium text-white transition hover:bg-forest dark:bg-[#ecece5] dark:text-[#151613] dark:hover:bg-[#90b89d]",
                    "secondary" => "inline-flex h-11 items-center rounded-md border border-black/15 px-5 text-sm font-medium transition hover:border-black/40 dark:border-white/15 dark:hover:border-white/40",
                    _ => "inline-flex h-11 items-center px-2 text-sm font-medium text-forest underline decoration-forest/25 underline-offset-4 dark:text-[#90b89d]"
                };
                <a href="@action.Url" target="@(action.OpenInNewTab ? "_blank" : null)" rel="@(action.OpenInNewTab ? "noopener noreferrer" : null)" class="@actionClass">@action.Text</a>
            }
        </div>
    </div>

    <figure class="mx-auto hidden w-full max-w-[220px] md:block lg:max-w-[340px]">
        <button type="button" class="portrait-flip aspect-square w-full cursor-pointer rounded-lg outline-none focus-visible:ring-4 focus-visible:ring-forest/20 dark:focus-visible:ring-[#90b89d]/20" aria-label="@portraitLabel">
            <span class="portrait-flip-inner block">
                <span class="portrait-flip-face block overflow-hidden rounded-lg border border-black/10 bg-[#dce7d8] p-2 dark:border-white/10 dark:bg-[#263127]">
                    <img src="~/images/iliya-ahmadi.webp" alt="" aria-hidden="true" class="aspect-square w-full rounded object-cover" />
                </span>
                <span class="portrait-flip-face portrait-flip-back block overflow-hidden rounded-lg border border-black/10 bg-[#e5e3dc] p-2 dark:border-white/10 dark:bg-[#292925]">
                    <img src="~/images/minecraft-chick.webp" alt="" aria-hidden="true" class="pixel-art aspect-square w-full rounded object-cover" />
                </span>
            </span>
        </button>
    </figure>
</section>

<section id="work" class="relative scroll-mt-24 border-t border-black/10 dark:border-white/10">
    <div class="mx-auto w-full max-w-6xl px-5 py-24 sm:px-8 sm:py-28">
        <h2 class="text-4xl font-semibold tracking-tight">@Model.Content.Work.Title</h2>

        <div class="mt-14 space-y-10">
            @foreach (var project in mainProjects)
            {
                var apiProject = Model.Projects.FirstOrDefault(candidate =>
                    candidate.Title.Equals($"{project.Title} API", StringComparison.OrdinalIgnoreCase));
                var isInDevelopment = project.Status?.Contains("development", StringComparison.OrdinalIgnoreCase) == true || project.Status?.Contains("توسعه") == true;
                var projectImages = project.ImageUrls.Count > 0
                    ? project.ImageUrls
                    : string.IsNullOrWhiteSpace(project.ImageUrl) ? [] : new List<string> { project.ImageUrl };
                var galleryLabel = culture switch
                {
                    "de" => $"Automatisch wechselnde Bildergalerie für das Projekt {project.Title}",
                    "fa" => $"گالری خودکار تصاویر پروژه {project.Title}",
                    _ => $"Automatically rotating screenshot gallery for {project.Title}"
                };

                <article class="overflow-hidden rounded-xl border border-black/10 bg-white/55 dark:border-white/10 dark:bg-white/[.025]">
                    <div class="grid lg:grid-cols-[1.05fr_.95fr]">
                        <div class="border-b border-black/10 p-4 dark:border-white/10 lg:border-b-0 lg:border-e">
                            @if (projectImages.Count > 0)
                            {
                                <div data-project-carousel data-slide-index="0" tabindex="0" class="project-gallery relative block aspect-[16/10] h-full w-full overflow-hidden rounded-lg border border-black/10 bg-[#101012] text-start outline-none focus-visible:ring-2 focus-visible:ring-forest/60 dark:border-white/10 dark:focus-visible:ring-[#90b89d]/60" role="region" aria-roledescription="carousel" aria-label="@galleryLabel">
                                    <div data-carousel-track dir="ltr" class="flex h-full transition-transform duration-700 ease-in-out motion-reduce:transition-none">
                                        @for (var imageIndex = 0; imageIndex < projectImages.Count; imageIndex++)
                                        {
                                            <div class="project-gallery-slide relative h-full w-full flex-none overflow-hidden">
                                                <img src="@projectImages[imageIndex]"
                                                     alt=""
                                                     aria-hidden="true"
                                                     loading="lazy"
                                                     decoding="async"
                                                     draggable="false"
                                                     class="project-gallery-backdrop absolute inset-0 h-full w-full object-cover object-center" />
                                                <img src="@projectImages[imageIndex]"
                                                     alt="@(culture switch { "de" => $"Bild {imageIndex + 1} von {projectImages.Count} des Projekts {project.Title}", "fa" => $"تصویر {imageIndex + 1} از پروژه {project.Title}", _ => $"{project.Title} screenshot {imageIndex + 1} of {projectImages.Count}" })"
                                                     loading="lazy"
                                                     decoding="async"
                                                     draggable="false"
                                                     class="project-gallery-image absolute inset-0 h-full w-full object-contain object-center" />
                                            </div>
                                        }
                                    </div>
                                    @if (projectImages.Count > 1)
                                    {
                                        <div class="absolute inset-x-0 bottom-3 z-20 flex justify-center gap-2" aria-label="@(culture switch { "de" => "Projektbild auswählen", "fa" => "انتخاب تصویر پروژه", _ => "Choose project screenshot" })">
                                            @for (var imageIndex = 0; imageIndex < projectImages.Count; imageIndex++)
                                            {
                                                <button type="button"
                                                        data-carousel-dot="@imageIndex"
                                                        class="h-2 w-2 rounded-full bg-white/45 shadow-sm ring-1 ring-black/20 transition-all hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
                                                        aria-label="@(culture switch { "de" => $"Bild {imageIndex + 1} anzeigen", "fa" => $"نمایش تصویر {imageIndex + 1}", _ => $"Show screenshot {imageIndex + 1}" })"
                                                        aria-current="@(imageIndex == 0 ? "true" : "false")"></button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="relative aspect-[16/10] overflow-hidden rounded-lg border border-black/10 bg-[#dfe7dd] dark:border-white/10 dark:bg-[#1b211c]">
                                    <div aria-hidden="true" class="absolute -inset-4 scale-105 opacity-55 blur-[2px] dark:opacity-45">
                                        <div class="absolute inset-0" style="background-image:linear-gradient(rgba(63,107,79,.13) 1px,transparent 1px),linear-gradient(90deg,rgba(63,107,79,.13) 1px,transparent 1px);background-size:26px 26px"></div>
                                        <div class="absolute inset-x-[13%] inset-y-[15%] overflow-hidden rounded-xl border border-forest/25 bg-white/45 shadow-xl dark:border-white/15 dark:bg-white/[.045]">
                                            <div class="flex h-8 items-center gap-1.5 border-b border-forest/15 px-3 dark:border-white/10">
                                                <span class="h-1.5 w-1.5 rounded-full bg-forest/25 dark:bg-white/20"></span>
                                                <span class="h-1.5 w-1.5 rounded-full bg-forest/25 dark:bg-white/20"></span>
                                                <span class="h-1.5 w-1.5 rounded-full bg-forest/25 dark:bg-white/20"></span>
                                            </div>
                                            <div class="grid h-[calc(100%_-_2rem)] grid-cols-[.36fr_1fr] gap-4 p-5">
                                                <div class="rounded-md bg-forest/10 dark:bg-white/[.05]"></div>
                                                <div class="space-y-3 pt-1">
                                                    <div class="h-3 w-2/3 rounded bg-forest/15 dark:bg-white/[.07]"></div>
                                                    <div class="h-2 w-full rounded bg-forest/10 dark:bg-white/[.05]"></div>
                                                    <div class="h-2 w-4/5 rounded bg-forest/10 dark:bg-white/[.05]"></div>
                                                    <div class="mt-5 grid grid-cols-2 gap-3">
                                                        <div class="h-14 rounded-md border border-forest/10 dark:border-white/[.06]"></div>
                                                        <div class="h-14 rounded-md border border-forest/10 dark:border-white/[.06]"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="absolute inset-0 grid place-items-center bg-white/10 backdrop-blur-[1px] dark:bg-black/10">
                                        <span class="rounded-full border border-forest/20 bg-[#eef2eb]/85 px-4 py-2 text-xs font-semibold tracking-wide text-forest shadow-sm backdrop-blur dark:border-white/15 dark:bg-[#171b17]/85 dark:text-[#a9cdb2]">@project.Status</span>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="flex flex-col justify-between p-6 sm:p-8">
                            <div>
                                <div class="flex flex-wrap items-center justify-between gap-3">
                                    <h3 class="text-3xl font-semibold tracking-tight">@project.Title</h3>
                                    @if (!string.IsNullOrWhiteSpace(project.Status) && (!isInDevelopment || projectImages.Count > 0))
                                    {
                                        <span class="rounded-full border px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.12em] @(isInDevelopment ? "border-amber-500/25 bg-amber-500/5 text-amber-700 dark:text-amber-300" : "border-forest/25 bg-forest/5 text-forest dark:text-[#90b89d]")">@project.Status</span>
                                    }
                                </div>
                                <p class="mt-5 text-sm leading-7 text-black/58 dark:text-white/58">@project.Description</p>
                                <div class="mt-6 flex flex-wrap gap-2">
                                    @foreach (var tech in project.TechStack)
                                    {
                                        <span class="rounded-md border border-black/10 bg-black/[.025] px-2.5 py-1.5 text-xs dark:border-white/10 dark:bg-white/[.035]">@tech</span>
                                    }
                                </div>
                            </div>

                            <div class="mt-8 flex flex-wrap gap-5 text-sm font-medium">
                                @if (!string.IsNullOrWhiteSpace(project.GitHubUrl))
                                {
                                    <a href="@project.GitHubUrl" target="_blank" rel="noreferrer" class="text-forest underline decoration-forest/25 underline-offset-4 dark:text-[#90b89d]">GitHub ↗</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(project.LiveDemoUrl))
                                {
                                    <a href="@project.LiveDemoUrl" target="_blank" rel="noreferrer" class="text-forest underline decoration-forest/25 underline-offset-4 dark:text-[#90b89d]">@Model.Content.Work.LiveDemo ↗</a>
                                }
                            </div>
                        </div>
                    </div>

                    @if (apiProject is not null)
                    {
                        <div class="border-t border-black/10 bg-black/[.018] p-5 dark:border-white/10 dark:bg-black/10 sm:p-6">
                            <div class="grid gap-5 sm:grid-cols-[160px_1fr_auto] sm:items-center">
                                <div>
                                    <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-black/40 dark:text-white/40">@Model.Content.Work.CompanionService</p>
                                    <h4 class="mt-1 font-semibold">@apiProject.Title</h4>
                                </div>
                                <div>
                                    <p class="text-xs leading-5 text-black/50 dark:text-white/50">@apiProject.Description</p>
                                    <div class="mt-3 flex flex-wrap gap-1.5">
                                        @foreach (var tech in apiProject.TechStack)
                                        {
                                            <span class="rounded border border-black/10 px-2 py-1 text-[10px] dark:border-white/10">@tech</span>
                                        }
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(apiProject.GitHubUrl))
                                {
                                    <a href="@apiProject.GitHubUrl" target="_blank" rel="noreferrer" class="text-xs font-medium text-forest dark:text-[#90b89d]">@Model.Content.Work.ApiSource ↗</a>
                                }
                            </div>
                        </div>
                    }
                </article>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const projectGalleries = [...document.querySelectorAll('[data-project-carousel]')];
        const reduceGalleryMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        function stopProjectGallery(gallery) {
            if (!gallery.galleryTimer) return;
            window.clearInterval(gallery.galleryTimer);
            gallery.galleryTimer = 0;
        }

        function showProjectGallerySlide(gallery, index) {
            const track = gallery.querySelector('[data-carousel-track]');
            const slides = track ? [...track.children] : [];
            if (!track || slides.length === 0) return;

            const nextIndex = ((index % slides.length) + slides.length) % slides.length;
            gallery.dataset.slideIndex = nextIndex.toString();
            track.style.transform = `translate3d(-${nextIndex * 100}%, 0, 0)`;

            gallery.querySelectorAll('[data-carousel-dot]').forEach((dot, dotIndex) => {
                const isActive = dotIndex === nextIndex;
                dot.setAttribute('aria-current', isActive.toString());
                dot.classList.toggle('w-5', isActive);
                dot.classList.toggle('bg-white', isActive);
                dot.classList.toggle('bg-white/45', !isActive);
            });
        }

        function advanceProjectGallery(gallery) {
            showProjectGallerySlide(gallery, Number(gallery.dataset.slideIndex || 0) + 1);
        }

        function startProjectGallery(gallery) {
            const track = gallery.querySelector('[data-carousel-track]');
            if (!track || track.children.length < 2 || gallery.galleryTimer || !gallery.classList.contains('is-visible') || reduceGalleryMotion.matches || document.hidden) return;
            gallery.galleryTimer = window.setInterval(() => advanceProjectGallery(gallery), 3500);
        }

        function syncProjectGalleries() {
            projectGalleries.forEach(gallery => {
                if (gallery.classList.contains('is-visible')) startProjectGallery(gallery);
                else stopProjectGallery(gallery);
            });
        }

        function updateActiveProjectGallery() {
            const viewportCenter = window.innerHeight / 2;
            let activeGallery = null;
            let closestDistance = Number.POSITIVE_INFINITY;

            projectGalleries.forEach(gallery => {
                const bounds = gallery.getBoundingClientRect();
                const visibleHeight = Math.min(bounds.bottom, window.innerHeight) - Math.max(bounds.top, 0);
                if (visibleHeight <= 0) return;

                const galleryCenter = bounds.top + bounds.height / 2;
                const distance = Math.abs(galleryCenter - viewportCenter);
                if (distance < closestDistance) {
                    closestDistance = distance;
                    activeGallery = gallery;
                }
            });

            projectGalleries.forEach(gallery => gallery.classList.toggle('is-visible', gallery === activeGallery));
            syncProjectGalleries();
        }

        let galleryScrollFrame = 0;
        function scheduleGalleryVisibilityUpdate() {
            if (galleryScrollFrame) return;
            galleryScrollFrame = window.requestAnimationFrame(() => {
                galleryScrollFrame = 0;
                updateActiveProjectGallery();
            });
        }

        projectGalleries.forEach(carousel => {
            carousel.querySelectorAll('[data-carousel-dot]').forEach(dot => {
                dot.addEventListener('click', () => {
                    stopProjectGallery(carousel);
                    showProjectGallerySlide(carousel, Number(dot.dataset.carouselDot));
                    startProjectGallery(carousel);
                });
            });
        });

        window.addEventListener('scroll', scheduleGalleryVisibilityUpdate, { passive: true });
        window.addEventListener('resize', scheduleGalleryVisibilityUpdate);
        reduceGalleryMotion.addEventListener('change', syncProjectGalleries);
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) projectGalleries.forEach(stopProjectGallery);
            else syncProjectGalleries();
        });
        updateActiveProjectGallery();
    </script>
}

<section id="experience" class="relative scroll-mt-24 border-t border-black/10 dark:border-white/10">
    <div dir="ltr" aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 mx-auto flex w-full max-w-6xl -translate-y-[88%] px-5 sm:px-8 lg:max-w-none lg:px-6 @(isRtl ? "justify-start" : "justify-end")">
        <img src="~/images/chick-dividers/experience.webp" alt="" class="pixel-art h-12 w-12" />
    </div>
    <div class="mx-auto w-full max-w-6xl px-5 py-24 sm:px-8 sm:py-28">
        <div class="flex items-center justify-between gap-6">
            <h2 class="text-4xl font-semibold tracking-tight">@Model.Content.Experience.Title</h2>
            @if (resumeAction is not null)
            {
                <a href="@resumeAction.Url" target="_blank" rel="noopener noreferrer" class="hidden flex-none text-sm font-medium text-forest underline decoration-forest/25 underline-offset-4 sm:block dark:text-[#90b89d]">@resumeAction.Text ↗</a>
            }
        </div>

        <div class="mt-14 border-t border-black/10 dark:border-white/10">
            @foreach (var group in groupedExperience)
            {
                <article class="grid gap-6 border-b border-black/10 py-10 md:grid-cols-[220px_1fr] md:gap-12 dark:border-white/10">
                    <div>
                        <div class="flex items-center gap-3">
                            @if (!string.IsNullOrWhiteSpace(group.Entries.First().LogoUrl))
                            {
                                <span class="grid h-9 w-9 place-items-center overflow-hidden rounded-md border border-black/10 bg-white p-1.5 dark:border-white/10"><img src="@group.Entries.First().LogoUrl" alt="" class="h-full w-full object-contain" /></span>
                            }
                            <h3 class="whitespace-nowrap font-semibold">@group.Company</h3>
                        </div>
                    </div>

                    <div class="space-y-9">
                        @foreach (var entry in group.Entries)
                        {
                            <div>
                                <div class="flex flex-wrap items-baseline justify-between gap-2">
                                    <div>
                                        <h4 class="font-medium">@(entry.Team ?? entry.Role)</h4>
                                        @if (!string.IsNullOrWhiteSpace(entry.Team))
                                        {
                                            <p class="mt-1 text-xs text-black/40 dark:text-white/40">@entry.Role</p>
                                        }
                                    </div>
                                    <span class="text-xs text-black/38 dark:text-white/38">@entry.DateRange</span>
                                </div>
                                <ul class="mt-4 space-y-2.5 text-sm leading-6 text-black/58 dark:text-white/58">
                                    @foreach (var point in entry.Highlights)
                                    {
                                        <li class="flex gap-3"><span class="mt-[10px] h-1 w-1 flex-none rounded-full bg-forest dark:bg-[#90b89d]"></span><span>@point</span></li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-2">
            @foreach (var card in Model.Content.Experience.InfoCards)
            {
                <div class="rounded-lg border border-black/10 p-5 dark:border-white/10">
                    <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-black/40 dark:text-white/40">@card.Label</p>
                    @if (!string.IsNullOrWhiteSpace(card.Heading))
                    {
                        <p class="mt-3 font-medium">@card.Heading</p>
                    }
                    <div class="mt-4 divide-y divide-black/[.07] dark:divide-white/[.07]">
                        @foreach (var item in card.Items)
                        {
                            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3 first:pt-0 last:pb-0">
                                <span class="text-sm font-medium">@item.Title</span>
                                <span dir="ltr" class="text-xs text-black/45 dark:text-white/45">@item.Detail</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section id="skills" class="relative scroll-mt-24 border-t border-black/10 dark:border-white/10">
    <div dir="ltr" class="pointer-events-none absolute inset-x-0 top-0 mx-auto flex w-full max-w-6xl -translate-y-[88%] px-5 sm:px-8 lg:max-w-none lg:px-6 @(isRtl ? "justify-end" : "justify-start")">
        <div class="pointer-events-auto relative">
            <span id="skills-chick-bubble" role="status" aria-live="polite" class="absolute bottom-full mb-2 hidden whitespace-nowrap border-2 border-ink bg-canvas px-3 py-2 font-mono text-xs font-medium shadow-[3px_3px_0_rgba(28,29,26,.22)] @(isRtl ? "right-0" : "left-0") dark:border-[#ecece5] dark:bg-[#151613] dark:shadow-[3px_3px_0_rgba(236,236,229,.16)]">
                @(isRtl ? "واااازااااپ" : "wazzzuuuppp")
                <span class="absolute -bottom-[7px] h-3 w-3 rotate-45 border-b-2 border-r-2 border-ink bg-canvas @(isRtl ? "right-4" : "left-4") dark:border-[#ecece5] dark:bg-[#151613]"></span>
            </span>
            <button type="button" onclick="toggleSkillsChick(this)" aria-controls="skills-chick-bubble" aria-expanded="false" aria-label="@(isRtl ? "جوجه پیکسلی" : "Pixel chicken")" class="block cursor-default outline-none focus-visible:ring-2 focus-visible:ring-forest/40 dark:focus-visible:ring-[#90b89d]/40">
                <img src="~/images/chick-dividers/skills.webp" alt="" aria-hidden="true" class="pixel-art h-12 w-12" />
            </button>
        </div>
    </div>
    <div class="mx-auto w-full max-w-6xl px-5 py-24 sm:px-8 sm:py-28">
        <h2 class="text-4xl font-semibold tracking-tight">@Model.Content.Skills.Title</h2>

        <div class="mt-14 space-y-4">
            @foreach (var group in Model.Content.Skills.Groups)
            {
                var skillsGridClass = group.Items.Count switch
                {
                    6 => "lg:grid-cols-6",
                    5 => "lg:grid-cols-5",
                    _ => "lg:grid-cols-4"
                };
                <div class="rounded-xl border border-black/10 p-6 dark:border-white/10">
                    <h3 class="text-sm font-semibold">@group.Title</h3>
                    <div dir="ltr" class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 @skillsGridClass">
                        @foreach (var skill in group.Items)
                        {
                            <div class="flex min-h-16 items-center gap-3 rounded-lg border border-black/[.06] bg-black/[.025] px-3 dark:border-white/[.06] dark:bg-white/[.035]">
                                <img src="@skill.LogoUrl" alt="" class="h-5 w-5 flex-none object-contain opacity-90" onerror="this.classList.add('hidden');this.nextElementSibling.classList.remove('hidden');this.nextElementSibling.classList.add('grid')" />
                                <span class="hidden h-5 w-5 flex-none place-items-center rounded bg-forest/10 text-[10px] font-semibold text-forest dark:text-[#90b89d]">@skill.Name.Substring(0, 1)</span>
                                <span class="text-xs font-medium">@skill.Name</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section id="contact" class="relative scroll-mt-24 border-t border-black/10 dark:border-white/10">
    <div dir="ltr" aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 mx-auto flex w-full max-w-6xl -translate-y-[88%] px-5 sm:px-8 lg:max-w-none lg:px-6 @(isRtl ? "justify-start" : "justify-end")">
        <img src="~/images/chick-dividers/contact.webp" alt="" class="pixel-art h-12 w-12" />
    </div>
    <div class="mx-auto grid w-full max-w-6xl gap-12 px-5 py-24 sm:px-8 sm:py-28 lg:grid-cols-[.82fr_1.18fr] lg:gap-16">
        <div class="lg:py-5">
            <span class="inline-flex items-center gap-2 rounded-full border border-forest/15 bg-white/45 px-3 py-1.5 text-xs font-medium text-forest dark:border-[#90b89d]/15 dark:bg-white/[.035] dark:text-[#90b89d]">
                <span class="h-2 w-2 rounded-full bg-[#4c9b64]"></span>
                @Model.Content.Contact.Availability
            </span>
            <h2 class="mt-5 text-4xl font-semibold tracking-tight">@Model.Content.Contact.Heading</h2>
            <p class="mt-5 max-w-md text-sm leading-7 text-black/55 dark:text-white/55">@Model.Content.Contact.Description</p>
            <div class="mt-9 space-y-2.5">
                <a href="mailto:@Model.Content.Contact.Email" class="group flex items-center justify-between gap-4 rounded-lg border border-black/10 bg-white/35 px-4 py-3.5 transition hover:border-forest/30 hover:bg-white/65 dark:border-white/10 dark:bg-white/[.025] dark:hover:border-[#90b89d]/30 dark:hover:bg-white/[.05]">
                    <span class="min-w-0"><span class="block text-[10px] font-semibold uppercase tracking-[0.12em] text-black/35 dark:text-white/35">@Model.Content.Contact.EmailLabel</span><span class="mt-1 block break-all text-sm font-medium">@Model.Content.Contact.Email</span></span>
                    <span class="text-forest transition group-hover:translate-x-0.5 dark:text-[#90b89d]">↗</span>
                </a>
                <div class="grid gap-2.5 sm:grid-cols-2">
                    @foreach (var link in Model.Content.Contact.Links)
                    {
                        <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between rounded-lg border border-black/10 bg-white/35 px-4 py-3.5 text-sm font-medium transition hover:border-forest/30 hover:bg-white/65 dark:border-white/10 dark:bg-white/[.025] dark:hover:border-[#90b89d]/30 dark:hover:bg-white/[.05]"><span>@link.Label</span><span class="text-forest transition group-hover:translate-x-0.5 dark:text-[#90b89d]">↗</span></a>
                    }
                </div>
            </div>
        </div>

        <div class="rounded-2xl border border-forest/15 bg-[#dfe6dc]/90 p-6 shadow-[0_28px_70px_-48px_rgba(41,72,49,.7)] dark:border-white/10 dark:bg-[#1c201c] dark:shadow-none sm:p-8">
            @if (Model.MessageSent)
            {
                <div role="status" aria-live="polite" class="grid min-h-[320px] place-items-center rounded-xl border border-forest/10 bg-white/45 p-8 text-center text-sm text-forest dark:border-white/10 dark:bg-black/15 dark:text-[#90b89d]">@Model.Content.Contact.SuccessMessage</div>
            }
            else
            {
                <form method="post" asp-page="/Index" asp-fragment="contact" class="space-y-5" novalidate>
                    @if (Model.MessageRateLimited)
                    {
                        <div role="alert" class="rounded-lg border border-[#b7793b]/25 bg-[#fff4e7]/80 px-4 py-3 text-sm leading-6 text-[#754515] dark:border-[#e1a865]/20 dark:bg-[#e1a865]/10 dark:text-[#efc28d]">
                            @Model.Content.Contact.RateLimitMessage.Replace("{minutes}", Model.RetryAfterMinutes.ToString())
                        </div>
                    }
                    @if (Model.MessageFailed)
                    {
                        <div role="alert" class="rounded-lg border border-[#b7793b]/25 bg-[#fff4e7]/80 px-4 py-3 text-sm leading-6 text-[#754515] dark:border-[#e1a865]/20 dark:bg-[#e1a865]/10 dark:text-[#efc28d]">
                            @Model.Content.Contact.FailureMessage
                        </div>
                    }
                    <div class="grid gap-5 sm:grid-cols-2">
                        <div>
                            <label asp-for="Input.Name" class="mb-2 block text-xs font-medium text-black/65 dark:text-white/65">@Model.Content.Contact.NameLabel</label>
                            <input asp-for="Input.Name" autocomplete="name" class="h-12 w-full rounded-lg border border-black/10 bg-white/75 px-4 text-sm shadow-sm outline-none transition placeholder:text-black/25 focus:border-forest/50 focus:bg-white focus:ring-4 focus:ring-forest/10 dark:border-white/10 dark:bg-black/20 dark:shadow-none dark:focus:border-[#90b89d]/45 dark:focus:bg-black/30 dark:focus:ring-[#90b89d]/10" />
                            <span asp-validation-for="Input.Name" class="mt-1.5 block text-xs text-red-500"></span>
                        </div>
                        <div>
                            <label asp-for="Input.Email" class="mb-2 block text-xs font-medium text-black/65 dark:text-white/65">@Model.Content.Contact.EmailFieldLabel</label>
                            <input asp-for="Input.Email" autocomplete="email" inputmode="email" class="h-12 w-full rounded-lg border border-black/10 bg-white/75 px-4 text-sm shadow-sm outline-none transition placeholder:text-black/25 focus:border-forest/50 focus:bg-white focus:ring-4 focus:ring-forest/10 dark:border-white/10 dark:bg-black/20 dark:shadow-none dark:focus:border-[#90b89d]/45 dark:focus:bg-black/30 dark:focus:ring-[#90b89d]/10" />
                            <span asp-validation-for="Input.Email" class="mt-1.5 block text-xs text-red-500"></span>
                        </div>
                    </div>
                    <div>
                        <label asp-for="Input.Message" class="mb-2 block text-xs font-medium text-black/65 dark:text-white/65">@Model.Content.Contact.MessageLabel</label>
                        <textarea asp-for="Input.Message" rows="6" class="w-full resize-none rounded-lg border border-black/10 bg-white/75 p-4 text-sm leading-6 shadow-sm outline-none transition placeholder:text-black/25 focus:border-forest/50 focus:bg-white focus:ring-4 focus:ring-forest/10 dark:border-white/10 dark:bg-black/20 dark:shadow-none dark:focus:border-[#90b89d]/45 dark:focus:bg-black/30 dark:focus:ring-[#90b89d]/10"></textarea>
                        <span asp-validation-for="Input.Message" class="mt-1.5 block text-xs text-red-500"></span>
                    </div>
                    <button type="submit" class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-lg bg-ink px-6 text-sm font-medium text-white transition hover:bg-forest focus:outline-none focus:ring-4 focus:ring-forest/15 sm:w-auto dark:bg-[#e7ebe5] dark:text-[#151613] dark:hover:bg-[#90b89d] dark:focus:ring-[#90b89d]/15"><span>@Model.Content.Contact.SubmitText</span><span aria-hidden="true">↗</span></button>
                </form>
            }
        </div>
    </div>
</section>
