@{
    var culture = ViewData["Culture"]?.ToString() ?? "en";
    var isRtl = culture == "fa";
}
<!DOCTYPE html>
<html lang="@culture" dir="@(isRtl ? "rtl" : "ltr")" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Iliya Ahmadi - software engineer focused on backend systems with .NET and Node.js." />
    <title>Iliya Ahmadi — @ViewData["Title"]</title>
    <meta name="theme-color" content="#151613" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Vazirmatn:wght@400;500;600&display=swap" rel="stylesheet" />
    <script>
        if (localStorage.getItem('theme') !== 'light') {
            document.documentElement.classList.add('dark');
        }
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['IBM Plex Sans', 'Vazirmatn', 'sans-serif'],
                        mono: ['IBM Plex Mono', 'monospace']
                    },
                    colors: {
                        canvas: '#f0f2ec',
                        ink: '#1c1d1a',
                        forest: '#3f6b4f'
                    }
                }
            }
        };
    </script>
    <style>
        body {
            font-family: 'IBM Plex Sans', 'Vazirmatn', sans-serif;
            background-image:
                radial-gradient(circle at 10% 8%, rgba(63, 107, 79, .10), transparent 30rem),
                radial-gradient(circle at 92% 30%, rgba(174, 137, 78, .07), transparent 27rem);
            background-attachment: fixed;
        }
        .dark body { background-image: none; }
        [dir="rtl"] body { font-family: 'Vazirmatn', 'IBM Plex Sans', sans-serif; }
        ::selection { color: #fff; background: #3f6b4f; }
        .pixel-art { image-rendering: pixelated; }
        .portrait-flip { perspective: 1000px; }
        .portrait-flip-inner {
            position: relative;
            height: 100%;
            width: 100%;
            transform-style: preserve-3d;
            transition: transform .65s cubic-bezier(.2, .75, .25, 1);
        }
        .portrait-flip:hover .portrait-flip-inner,
        .portrait-flip:focus-visible .portrait-flip-inner { transform: rotateY(180deg); }
        .portrait-flip-face {
            position: absolute;
            inset: 0;
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
        }
        .portrait-flip-back { transform: rotateY(180deg); }
        @@media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            .portrait-flip-inner { transition: none; }
        }
    </style>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
</head>
<body class="overflow-x-hidden bg-canvas text-ink antialiased transition-colors dark:bg-[#151613] dark:text-[#ecece5]">

<header class="sticky top-0 z-50 border-b border-black/10 bg-canvas/95 backdrop-blur dark:border-white/10 dark:bg-[#151613]/95">
    <nav class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-5 sm:px-8" aria-label="Main navigation">
        <a asp-page="/Index" class="text-sm font-semibold tracking-tight">Iliya Ahmadi</a>

        <ul class="hidden items-center gap-7 text-sm md:flex">
            <li><a href="/#work" class="text-black/55 transition hover:text-black dark:text-white/55 dark:hover:text-white">@(isRtl ? "پروژه‌ها" : "Work")</a></li>
            <li><a href="/#experience" class="text-black/55 transition hover:text-black dark:text-white/55 dark:hover:text-white">@(isRtl ? "تجربه" : "Experience")</a></li>
            <li><a href="/#skills" class="text-black/55 transition hover:text-black dark:text-white/55 dark:hover:text-white">@(isRtl ? "مهارت‌ها" : "Skills")</a></li>
            <li><a href="/#contact" class="text-black/55 transition hover:text-black dark:text-white/55 dark:hover:text-white">@(isRtl ? "تماس" : "Contact")</a></li>
        </ul>

        <div class="flex items-center gap-2">
            <a asp-page="/Lab/Index" class="hidden h-9 items-center rounded-md border border-forest/30 bg-forest/5 px-3 text-xs font-medium text-forest transition hover:bg-forest hover:text-white sm:inline-flex dark:border-[#90b89d]/30 dark:text-[#90b89d]">
                @(isRtl ? "آزمایشگاه" : "Lab") <span class="ms-1">↗</span>
            </a>
            <form method="get" action="/">
                <input type="hidden" name="lang" value="@(isRtl ? "en" : "fa")" />
                <button type="submit" class="grid h-9 min-w-9 place-items-center rounded-md border border-black/15 px-2 text-xs font-medium transition hover:border-black/40 dark:border-white/15 dark:hover:border-white/40" aria-label="@(isRtl ? "Switch to English" : "تغییر زبان به فارسی")">
                    @(isRtl ? "EN" : "فا")
                </button>
            </form>
            <button type="button" onclick="toggleTheme()" class="grid h-9 w-9 place-items-center rounded-md border border-black/15 transition hover:border-black/40 dark:border-white/15 dark:hover:border-white/40" aria-label="Toggle color theme">
                <svg class="h-4 w-4 dark:hidden" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M16 12.4A6.5 6.5 0 0 1 7.6 4 6.5 6.5 0 1 0 16 12.4Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
                <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="3.25" stroke="currentColor" stroke-width="1.4" /><path d="M10 2v1.5M10 16.5V18M2 10h1.5M16.5 10H18M4.34 4.34 5.4 5.4M14.6 14.6l1.06 1.06M15.66 4.34 14.6 5.4M5.4 14.6l-1.06 1.06" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
            </button>
            <button id="nav-toggle" type="button" class="grid h-9 w-9 place-items-center rounded-md border border-black/15 text-lg md:hidden dark:border-white/15" aria-label="Toggle navigation" aria-expanded="false">≡</button>
        </div>
    </nav>

    <nav id="nav-menu-mobile" class="hidden border-t border-black/10 px-5 py-3 md:hidden dark:border-white/10" aria-label="Mobile navigation">
        <a href="/#work" class="block py-3 text-sm">@(isRtl ? "پروژه‌ها" : "Work")</a>
        <a href="/#experience" class="block py-3 text-sm">@(isRtl ? "تجربه" : "Experience")</a>
        <a href="/#skills" class="block py-3 text-sm">@(isRtl ? "مهارت‌ها" : "Skills")</a>
        <a href="/#contact" class="block py-3 text-sm">@(isRtl ? "تماس" : "Contact")</a>
        <a asp-page="/Lab/Index" class="my-2 inline-flex rounded-md border border-forest/30 px-3 py-2 text-xs font-medium text-forest dark:text-[#90b89d]">@(isRtl ? "باز کردن آزمایشگاه" : "Open Lab") ↗</a>
    </nav>
</header>

<main>@RenderBody()</main>

<footer class="border-t border-black/10 dark:border-white/10">
    <div class="mx-auto flex w-full max-w-6xl flex-col justify-between gap-4 px-5 py-8 text-xs text-black/45 sm:flex-row sm:items-center sm:px-8 dark:text-white/45">
        <span>&copy; 2026 Iliya Ahmadi</span>
    </div>
</footer>

<script>
    function toggleTheme() {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
    }

    function toggleSkillsChick(button) {
        const bubble = document.getElementById('skills-chick-bubble');
        const isOpen = bubble.classList.toggle('hidden') === false;
        button.setAttribute('aria-expanded', isOpen.toString());
    }

    const navToggle = document.getElementById('nav-toggle');
    const mobileNav = document.getElementById('nav-menu-mobile');
    navToggle?.addEventListener('click', () => {
        const willOpen = mobileNav.classList.contains('hidden');
        mobileNav.classList.toggle('hidden');
        navToggle.setAttribute('aria-expanded', willOpen.toString());
        navToggle.textContent = willOpen ? '×' : '≡';
    });
    mobileNav?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
        mobileNav.classList.add('hidden');
        navToggle.setAttribute('aria-expanded', 'false');
        navToggle.textContent = '≡';
    }));
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
